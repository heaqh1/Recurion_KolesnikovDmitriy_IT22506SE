def binary_search(arr, target, left, right):
    if left > right:
        return -1

    mid = (left + right) // 2

    if arr[mid] == target:
        return mid

    if target < arrreturn binary_search(arr, target, left, mid - 1)

    return binary_search(arr, target, mid + 1, right)


arr = [2, 4, 7, 10, 15, 21]
target = 15

print(binary_search(arr, target, 0, len(arr) - 1))
