def is_safe(board, row, col):
    for i in range(row):
        if board[i] == col:
            return False

    for i in range(row):
        if abs(board[i] - col) == abs(i - row):
            return False

    return True


def solve(board, row):
    if row == len(board):
        print(board)
        return

    for col in range(len(board)):
        if is_safe(board, row, col):
            board[row] = col
            solve(board, row + 1)


n = 4
board = [-1] * n

solve(board, 0)
